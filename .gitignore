.env
glimors/
factories/mac/.keyboard-native.state

# Python bytecode
__pycache__/
*.pyc

# live agent state — never source. These are regenerated by the agent at
# runtime; only the identity files under deployments/ (name, kind, meta.yaml,
# allowlist.txt, SOUL.md, config.yaml, settings.json, …) are committed.
state.db
.hermes_history
version_cache.json

# durable-boot-proof/ = generated evidence from boot checks, not source
durable-boot-proof/

# ── instance identity is NOT repository material ──────────────────────────────
# Saved agent identities (personas, memory, per-agent settings) belong to the
# instance that created them. Commit one only deliberately; the default is to
# keep them out. See docs/REPOSITORY-VS-INSTANCE.md.
deployments/*
!deployments/README.md
# Per-agent Hermes SOUL files are written per instance.
factories/sudo-agent/config/*.SOUL.md
factories/sudo-letta/.env
factories/sudo-agent/.env

# Instance daily logs (/tmp/oct<N>/<name>/logs/) are operator records of ONE fleet.
# They name real agents and deployment counts; they never belong in a public repo.
logs/
