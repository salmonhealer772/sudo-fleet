{
  "name": "@letta-ai/message-agent",
  "version": "0.2.0",
  "description": "Letta Code mod package that adds an agent-callable message_agent tool for messaging any sibling agent in the sudo-fleet by name and reading its reply.",
  "author": "forge",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "letta-package",
    "letta-mod",
    "letta-code",
    "fleet",
    "message",
    "mesh",
    "siblings"
  ],
  "files": [
    "README.md",
    "MOD.md",
    "mods"
  ],
  "letta": {
    "manifestVersion": 1,
    "mods": [
      "./mods/index.mjs"
    ],
    "capabilities": [
      "tools",
      "events.tools"
    ],
    "engines": {
      "lettaCodeCli": ">=0.27.14"
    }
  }
}
